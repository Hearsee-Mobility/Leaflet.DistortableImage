{
  "name": "@hearsee-mobility/leaflet-distortableimage",
  "version": "0.0.0-semantic-release",
  "type": "module",
  "description": "Leaflet plugin enabling image overlays to be distorted, stretched, and warped (built for Public Lab's MapKnitter: http://publiclab.org).",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist/leaflet.distortableimage.iife.js",
    "dist/leaflet.distortableimage.css",
    "types"
  ],
  "scripts": {
    "setup": "npm i && npm run build",
    "dev": "vite",
    "build": "npm run build:types && vite build",
    "build:types": "tsc --emitDeclarationOnly --sourceMap",
    "preview": "vite preview",
    "serve:dev": "vite",
    "watch:dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test examples/js",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "format": "prettier src/ --write"
  },
  "browserslist": "> 2%, last 2 versions, not dead",
  "main": "dist/leaflet.distortableimage.iife.js",
  "types": "types/leaflet-distortableimage.d.ts",
  "exports": {
    ".": {
      "import": "./dist/leaflet.distortableimage.iife.js",
      "types": "./types/leaflet-distortableimage.d.ts"
    },
    "./dist/leaflet.distortableimage.css": "./dist/leaflet.distortableimage.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hearsee-Mobility/Leaflet.DistortableImage.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "leaflet",
    "mapknitter",
    "rubbersheeting",
    "maps"
  ],
  "directories": {
    "examples": "./examples",
    "distribution": "./dist",
    "source": "./src",
    "tests": "./test"
  },
  "author": "Anish Shah, Jeff Warren, Justin Manley, Sasha Boginsky, Pranshu Srivastava",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Hearsee-Mobility/Leaflet.DistortableImage"
  },
  "homepage": "https://github.com/Hearsee-Mobility/Leaflet.DistortableImage",
  "dependencies": {
    "exifreader": "4.48.1",
    "glfx": "0.0.4",
    "leaflet-toolbar": "0.4.0-alpha.2",
    "webgl-distort": "0.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@semantic-release/changelog": "^6.0.3",
    "@types/leaflet": "^1.9.20",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "husky": "^9.1.7",
    "leaflet": "1.x",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.6.2",
    "semantic-release": "^25.0.9",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "leaflet": "1.x"
  },
  "lint-staged": {
    "{src,test,examples/js}/**/*.js": "eslint",
    "src/**/*.{js,ts}": "prettier --write"
  }
}
