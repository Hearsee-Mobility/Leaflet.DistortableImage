{
  "env": {
    "browser": true,
    "commonjs": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "google"
  ],
  "globals": {
    "Atomics": "readonly",
    "SharedArrayBuffer": "readonly",
    "L": "readonly",
    "ExifReader": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 8,
    "sourceType": "module"
  },
  "rules": {
    "new-cap": "off",
    "block-spacing": "off",
    "prefer-const": "off",
    "no-var": "off",
    "max-len": ["error", {"code": 200, "ignoreStrings": true}],
    "require-jsdoc": "off",
    "valid-jsdoc": "off",
    "camelcase": "off",
    "brace-style": "off",
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-extend-native": "off",
    "no-invalid-this": "off",
    "object-curly-spacing": "off",
    "space-before-function-paren": "off",
    "one-var": "off",
    "operator-linebreak": "off",
    "no-use-before-define": "off",
    "no-throw-literal": "off",
    "no-loop-func": "off",
    "no-prototype-builtins": "off",
    "quotes": "off",
    "indent": "off",
    "comma-dangle": "off",
    "no-trailing-spaces": "off",
    "eol-last": "off",
    "no-multiple-empty-lines": "off",
    "guard-for-in": "off",
    "no-lonely-if": "off",
    "padded-blocks": "off",
    "no-floating-decimal": "off",
    "space-infix-ops": "off",
    "spaced-comment": "off",
    "no-multi-spaces": "off",
    "keyword-spacing": "off",
    "prefer-rest-params": "off",
    "prefer-spread": "off",
    "space-before-blocks": "off",
    "curly": "off",
    "no-else-return": "off",
    "no-nested-ternary": "error",
    "no-mixed-operators": "off",
    "no-useless-return": "off",
    "no-shadow": "off",
    "arrow-parens": "off",
    "no-unmodified-loop-condition": "off",
    "no-sequences": "off",
    "no-undef": "off",
    "no-extra-semi": "off"
  },
  "overrides": [
    {
      "files": [
        "src/**/*.ts"
      ],
      "parser": "@typescript-eslint/parser"
    },
    {
      "files": [
        "src/**/*.ts"
      ],
      "excludedFiles": [
        "src/index.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "L",
            "message": "Internal modules stay Leaflet-free (docs/adr/0001); take what you need as arguments from the L adapter."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "leaflet",
                "message": "Internal modules stay Leaflet-free (docs/adr/0001); only src/index.ts and the L adapters touch Leaflet."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/**/*.js",
        "src/**/*.ts"
      ],
      "rules": {
        "complexity": [
          "error",
          10
        ],
        "max-depth": [
          "error",
          4
        ]
      }
    },
    {
      "files": [
        "test/**/*.js"
      ],
      "globals": {
        "describe": "readonly",
        "it": "readonly",
        "test": "readonly",
        "expect": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "beforeAll": "readonly",
        "afterAll": "readonly",
        "vi": "readonly",
        "chai": "readonly",
        "assert": "readonly",
        "suite": "readonly"
      }
    },
    {
      "files": [
        "examples/js/**/*.js"
      ],
      "globals": {
        "bootstrap": "readonly",
        "axios": "readonly"
      }
    }
  ]
}
